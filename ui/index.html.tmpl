<!doctype html>
<html lang="en">
<head>
	<meta charset="utf-8">
	<meta name="viewport" content="width=device-width, initial-scale=1">
	<title>dnsbench</title>
	<link rel="icon" href="data:,">
	<link rel="stylesheet" href="/static/style.css">
	<script src="/static/app.js" defer></script>
</head>
<body>
<header class="masthead">
	<div class="brand">
		<h1>dnsbench</h1>
		<p class="run-line" id="run-line">Pick resolvers and domains, then start a benchmark.</p>
	</div>
	<div class="actions">
		<span id="status" class="status" data-status="idle">idle</span>
		<button type="button" id="reset" class="quiet">Reset</button>
		<button type="button" id="stop" class="danger" disabled>Stop</button>
		<button type="submit" id="start" form="config">Start benchmark</button>
	</div>
	<div class="progress" aria-hidden="true"><span id="progress-fill"></span></div>
</header>

<p id="notice" class="notice" role="alert" hidden></p>

<div class="layout">
	<form id="config" class="setup" autocomplete="off">
		<fieldset id="setup-fields">
			<legend class="visually-hidden">Benchmark setup</legend>

			<section class="block">
				<div class="block-head">
					<h2><label for="domains">Domains</label></h2>
					<span class="count"><span id="domain-count">0</span> domains</span>
				</div>
				<textarea id="domains" name="domains" rows="8" spellcheck="false">{{.Domains}}</textarea>
				<p class="hint">One per line. Lines starting with <code>#</code> are skipped.</p>
			</section>

			<section class="block">
				<div class="block-head">
					<h2>Resolvers</h2>
					<span class="count" id="resolver-count">0 selected</span>
				</div>

				<div class="segmented" role="radiogroup" aria-label="Resolver source">
					<label><input type="radio" name="resolver-source" value="builtin" checked><span>Built-in</span></label>
					<label><input type="radio" name="resolver-source" value="custom"><span>Your own</span></label>
				</div>

				<div id="builtin-options">
					<div class="filters">
						<div class="segmented small" role="radiogroup" aria-label="Address family">
							<label><input type="radio" name="family" value="ipv4" {{if eq .Options.Family "ipv4"}}checked{{end}}><span>IPv4</span></label>
							<label><input type="radio" name="family" value="ipv6" {{if eq .Options.Family "ipv6"}}checked{{end}}><span>IPv6</span></label>
							<label><input type="radio" name="family" value="all" {{if eq .Options.Family "all"}}checked{{end}}><span>Both</span></label>
						</div>
						<div class="segmented small" role="radiogroup" aria-label="Transport">
							<label><input type="radio" name="transport" value="plain" {{if eq .Options.Transport "plain"}}checked{{end}}><span>Plain</span></label>
							<label><input type="radio" name="transport" value="dot" {{if eq .Options.Transport "dot"}}checked{{end}}><span>DoT</span></label>
							<label><input type="radio" name="transport" value="all" {{if eq .Options.Transport "all"}}checked{{end}}><span>Both</span></label>
						</div>
						<label class="check"><input type="checkbox" id="only-major" {{if .Options.OnlyMajor}}checked{{end}}> Major providers only</label>
						<label class="check" title="Most providers list two addresses that perform alike. Test only the first, such as Cloudflare-1, to halve the run."><input type="checkbox" id="primary-only" {{if .Options.PrimaryOnly}}checked{{end}}> First address only</label>
					</div>
					<div class="picker-tools">
						<button type="button" class="link" id="select-all">Select all</button>
						<button type="button" class="link" id="select-none">Select none</button>
					</div>
					<ul id="builtin-list" class="picker"></ul>
				</div>

				<div id="custom-options" hidden>
					<textarea id="custom-resolvers" rows="7" spellcheck="false" placeholder="Cloudflare;1.1.1.1&#10;Cloudflare-DoT;1.1.1.1;cloudflare-dns.com&#10;Router;fe80::1%eth0"></textarea>
					<p class="hint">One resolver per line: <code>name;ip</code> for plain DNS, or <code>name;ip;tls-name</code> for DNS over TLS, where <code>tls-name</code> is the name on its certificate. A link-local IPv6 address needs its zone, as in <code>fe80::1%eth0</code>.</p>
				</div>
			</section>

			<section class="block">
				<h2>Lookups</h2>
				<div class="numbers">
					<label>Repeats per domain
						<input type="number" id="repeats" min="1" value="{{.Options.Repeats}}">
					</label>
					<label>Timeout per attempt, ms
						<input type="number" id="timeout" min="100" step="100" value="{{.Options.TimeoutMs}}">
					</label>
					<label>Concurrent lookups
						<input type="number" id="concurrency" min="1" value="{{.Options.Concurrency}}">
					</label>
					<label>Warmup lookups
						<input type="number" id="warmup" min="0" value="{{.Options.Warmup}}">
					</label>
				</div>
			</section>
		</fieldset>
	</form>

	<main class="board">
		<section class="summary" aria-label="Summary">
			<pre id="summary">;; no results yet</pre>
		</section>

		<section class="ladder" aria-labelledby="ladder-title">
			<div class="ladder-head">
				<h2 id="ladder-title">Latency of every lookup</h2>
				<div class="ladder-tools">
					<label class="inline">Sort by
						<select id="sort">
							<option value="p50">median</option>
							<option value="p95">95th percentile</option>
							<option value="success">success rate</option>
							<option value="name">name</option>
						</select>
					</label>
					<button type="button" class="quiet" id="export-csv" disabled>Download CSV</button>
					<button type="button" class="quiet" id="export-json" disabled>Download JSON</button>
				</div>
			</div>

			<div class="grid-row axis-row" aria-hidden="true">
				<span>Resolver</span>
				<div class="axis" id="axis"></div>
				<span class="num">p50</span>
				<span class="num">p95</span>
				<span class="num">OK</span>
			</div>

			<ol id="ladder" class="rows"></ol>
			<p id="ladder-empty" class="empty">Each lookup lands here as a dot on a log scale, so you see how much a resolver varies as well as how fast it is. The bar marks the median, the caret the 95th percentile, and the red gutter on the right the failed lookups. Click a resolver for its slowest domains and its errors.</p>
		</section>

		<details class="log">
			<summary>Lookup log <span class="count" id="log-count"></span></summary>
			<ol id="log"></ol>
		</details>
	</main>
</div>

<script type="application/json" id="builtins">{{.Builtins}}</script>
</body>
</html>
