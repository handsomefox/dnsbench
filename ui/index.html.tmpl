<!doctype html>
<html lang="en">
<head>
	<meta charset="utf-8">
	<meta name="viewport" content="width=device-width, initial-scale=1">
	<title>dnsbench</title>
	<link rel="icon" href="data:,">
	<link rel="preload" href="/static/fonts/instrument-sans.woff2" as="font" type="font/woff2" crossorigin>
	<link rel="preload" href="/static/fonts/martian-mono.woff2" as="font" type="font/woff2" crossorigin>
	<link rel="stylesheet" href="/static/style.css">
	<script src="/static/app.js" defer></script>
</head>
<body>
<header class="masthead">
	<div class="brand">
		<h1>dnsbench</h1>
		<p class="run-line" id="run-line">Pick resolvers and domains, then start a benchmark.</p>
	</div>
	<div class="actions">
		<span id="status" class="status" data-status="idle">idle</span>
		<button type="button" id="reset" class="quiet" title="Clear the results and restore the default setup">Reset</button>
		<button type="button" id="stop" class="danger" disabled>Stop</button>
		<button type="submit" id="start" form="config" title="Start benchmark (Ctrl+Enter)">Start benchmark</button>
	</div>
	<div class="progress" aria-hidden="true"><span id="progress-fill"></span></div>
</header>

<p id="notice" class="notice" role="alert" hidden></p>

<div class="layout">
	<form id="config" class="setup" autocomplete="off">
		<fieldset id="setup-fields">
			<legend class="visually-hidden">Benchmark setup</legend>

			<section class="block">
				<div class="block-head">
					<h2>Presets</h2>
					<span class="count" id="preset-name">custom</span>
				</div>
				<div class="presets" id="presets" role="group" aria-label="Presets"></div>
				<p class="preset-detail" id="preset-detail"></p>
			</section>

			<section class="block resolvers">
				<div class="block-head">
					<h2>Resolvers</h2>
					<span class="count" id="resolver-count">0 selected</span>
				</div>

				<div class="filter-grid">
					<span class="filter-label">Address</span>
					<div class="toggles" id="filter-family" role="group" aria-label="Address family">
						<button type="button" data-value="ipv4">IPv4</button>
						<button type="button" data-value="ipv6">IPv6</button>
					</div>
					<span class="filter-label">Transport</span>
					<div class="toggles" id="filter-transport" role="group" aria-label="Transport">
						<button type="button" data-value="plain" title="Plain DNS over UDP and TCP port 53">Plain</button>
						<button type="button" data-value="dot" title="DNS over TLS, TCP port 853">DoT</button>
						<button type="button" data-value="doh" title="DNS over HTTPS, TCP port 443">DoH</button>
						<button type="button" data-value="doq" title="DNS over QUIC, UDP port 853">DoQ</button>
					</div>
					<span class="filter-label">Kind</span>
					<div class="toggles" id="filter-category" role="group" aria-label="Kind of resolver">
						<button type="button" data-value="Global" title="Large public resolvers without filtering">Global</button>
						<button type="button" data-value="Filtering" title="Resolvers that block ads, malware, or adult content">Filtering</button>
						<button type="button" data-value="Privacy" title="Small operators that promise no logging">Privacy</button>
						<button type="button" data-value="Regional" title="Resolvers run for one country or region">Regional</button>
					</div>
				</div>
				<div class="checks">
					<label class="check" title="Cloudflare, Google, Quad9, AdGuard, and NextDNS"><input type="checkbox" id="only-major"> Major providers only</label>
					<label class="check" title="Most providers list two addresses that perform alike. Test only the first, such as Cloudflare-1."><input type="checkbox" id="primary-only"> First address only</label>
				</div>

				<div class="picker-bar">
					<input type="search" id="resolver-search" placeholder="Search providers or addresses  /" aria-label="Search resolvers">
					<button type="button" class="link" id="select-all">All</button>
					<button type="button" class="link" id="select-none">None</button>
				</div>
				<ul id="builtin-list" class="picker"></ul>

				<details class="disclose" id="custom-block">
					<summary>Add your own resolvers <span class="count" id="custom-count"></span></summary>
					<textarea id="custom-resolvers" rows="5" spellcheck="false" placeholder="Router;192.168.1.1&#10;Cloudflare-DoH;1.1.1.1;https://cloudflare-dns.com/dns-query&#10;AdGuard-DoQ;94.140.14.14;quic://dns.adguard-dns.com"></textarea>
					<p class="hint">One per line, added to the selection above: <code>name;ip</code> for plain DNS, <code>name;ip;tls-name</code> for DoT, <code>name;ip;https-url</code> for DoH, or <code>name;ip;quic://tls-name</code> for DoQ. A link-local IPv6 address needs its zone, as in <code>fe80::1%eth0</code>.</p>
					<ul class="problems" id="custom-problems"></ul>
				</details>
			</section>

			<section class="block">
				<div class="block-head">
					<h2>Domains and lookups</h2>
					<span class="count"><span id="domain-count">0</span> domains</span>
				</div>
				<div class="domain-row">
					<div class="toggles" id="domain-sets" role="group" aria-label="Domain list">
						<button type="button" data-value="quick" title="Twelve of the most visited sites">12 popular</button>
						<button type="button" data-value="all" title="The full built-in list">All built-in</button>
					</div>
					<button type="button" class="link" id="edit-domains" aria-expanded="false" aria-controls="domains-block">Edit list</button>
				</div>
				<div id="domains-block" hidden>
					<textarea id="domains" name="domains" rows="8" spellcheck="false" aria-label="Domains, one per line">{{.Domains}}</textarea>
					<p class="hint">One per line. Lines starting with <code>#</code> are skipped.</p>
				</div>
				<div class="numbers">
					<label title="Measured lookups of each domain against each resolver">Repeats
						<input type="number" id="repeats" min="1" value="{{.Options.Repeats}}">
					</label>
					<label title="Timeout for one lookup attempt, in milliseconds. A failed attempt is retried.">Timeout, ms
						<input type="number" id="timeout" min="100" step="100" value="{{.Options.TimeoutMs}}">
					</label>
					<label title="Lookups in flight at once, across all resolvers">Parallel
						<input type="number" id="concurrency" min="1" value="{{.Options.Concurrency}}">
					</label>
					<label title="Unmeasured lookups of a domain right before a resolver's first measured lookup of it">Warmup
						<input type="number" id="warmup" min="0" value="{{.Options.Warmup}}">
					</label>
				</div>
			</section>
		</fieldset>

		<p class="estimate" id="estimate"></p>
	</form>

	<main class="board">
		<section class="readouts" aria-label="Summary">
			<div class="readout">
				<span class="label">Fastest median</span>
				<span class="value" id="sum-fastest">—</span>
				<span class="sub" id="sum-fastest-name">no results yet</span>
			</div>
			<div class="readout">
				<span class="label">Most reliable</span>
				<span class="value" id="sum-reliable">—</span>
				<span class="sub" id="sum-reliable-name"></span>
			</div>
			<div class="readout">
				<span class="label">Lookups</span>
				<span class="value" id="sum-lookups">0</span>
				<span class="sub" id="sum-lookups-of"></span>
			</div>
			<div class="readout">
				<span class="label">No answer at all</span>
				<span class="value" id="sum-failed">—</span>
				<span class="sub" id="sum-failed-of"></span>
			</div>
		</section>

		<section class="ladder" aria-labelledby="ladder-title">
			<div class="ladder-head">
				<h2 id="ladder-title">Latency of every lookup</h2>
				<div class="ladder-tools">
					<div class="toggles small" id="ladder-transport" role="group" aria-label="Show transports" hidden></div>
					<label class="inline">Sort by
						<select id="sort">
							<option value="p50">median</option>
							<option value="p95">95th percentile</option>
							<option value="success">success rate</option>
							<option value="name">name</option>
						</select>
					</label>
					<button type="button" class="quiet" id="export-csv" disabled>Download CSV</button>
					<button type="button" class="quiet" id="export-json" disabled>Download JSON</button>
				</div>
			</div>

			<div class="grid-row axis-row" aria-hidden="true">
				<span>Resolver</span>
				<div class="axis" id="axis"></div>
				<span class="num">p50</span>
				<span class="num">p95</span>
				<span class="num">OK</span>
			</div>

			<ol id="ladder" class="rows"></ol>
			<p id="ladder-empty" class="empty">Each lookup lands here as a dot on a log scale, so you see how much a resolver varies as well as how fast it is. The dot color is the transport. The bar marks the median, the caret the 95th percentile, and the red gutter on the right the failed lookups. Click a resolver for its slowest domains and its errors.</p>
		</section>
	</main>
</div>

<script type="application/json" id="builtins">{{.Builtins}}</script>
<script type="application/json" id="default-domains">{{.DefaultDomains}}</script>
<script type="application/json" id="defaults">{{.Options}}</script>
</body>
</html>
