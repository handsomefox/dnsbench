<!doctype html>
<html lang="en">
<head>
	<meta charset="utf-8">
	<meta name="viewport" content="width=device-width, initial-scale=1">
	<title>dnsbench</title>
	<link rel="stylesheet" href="/static/style.css">
	<script src="/static/app.js" defer></script>
</head>
<body>
<header class="top">
	<div>
		<h1>dnsbench</h1>
		<p class="muted">Pick domains and resolvers, start a run, and watch the results arrive.</p>
	</div>
	<div class="actions">
		<span id="status" class="badge">idle</span>
		<button type="button" id="reset" class="secondary">Reset</button>
		<button type="button" id="stop" class="danger" disabled>Stop</button>
		<button type="submit" id="start" form="config">Start benchmark</button>
	</div>
</header>

<p id="notice" class="notice" role="alert" hidden></p>

<main class="grid">
	<form id="config" class="panel" autocomplete="off">
		<h2>Configuration</h2>

		<label for="domains">Domains <span class="muted">(one per line)</span></label>
		<textarea id="domains" name="domains" rows="10" spellcheck="false">{{.Domains}}</textarea>
		<p class="hint"><span id="domain-count">0</span> domains</p>

		<fieldset>
			<legend>Resolvers</legend>
			<label class="inline"><input type="radio" name="resolver-source" value="builtin" checked> Built-in</label>
			<label class="inline"><input type="radio" name="resolver-source" value="custom"> Custom</label>

			<div id="builtin-options">
				<label class="inline"><input type="checkbox" id="only-major" {{if .Options.OnlyMajor}}checked{{end}}> Major providers only</label>
				<ul id="builtin-list" class="chips"></ul>
			</div>

			<div id="custom-options" hidden>
				<textarea id="custom-resolvers" rows="6" spellcheck="false" placeholder="Cloudflare;1.1.1.1"></textarea>
				<p class="hint">One <code>name;ip</code> per line. The address must be an IP with no port.</p>
			</div>
			<p class="hint"><span id="resolver-count">0</span> resolvers</p>
		</fieldset>

		<div class="numbers">
			<label>Repeats
				<input type="number" id="repeats" min="1" value="{{.Options.Repeats}}">
			</label>
			<label>Timeout per attempt (ms)
				<input type="number" id="timeout" min="100" step="100" value="{{.Options.TimeoutMs}}">
			</label>
			<label>Concurrency
				<input type="number" id="concurrency" min="1" value="{{.Options.Concurrency}}">
			</label>
			<label>Warmup lookups
				<input type="number" id="warmup" min="0" value="{{.Options.Warmup}}">
			</label>
		</div>
	</form>

	<section class="panel">
		<h2>Live run</h2>
		<div class="progress-row">
			<span id="progress-label" class="muted">0/0 resolvers</span>
			<span id="progress-pct">0%</span>
		</div>
		<progress id="progress" max="100" value="0"></progress>
		<p class="current"><span class="muted">Querying</span> <strong id="active">nothing</strong></p>
		<h3>Recent lookups</h3>
		<ol id="log" class="log"></ol>
	</section>

	<section class="panel">
		<div class="panel-head">
			<h2>Results</h2>
			<label class="inline">Sort by
				<select id="sort">
					<option value="success">success rate</option>
					<option value="mean">mean latency</option>
				</select>
			</label>
		</div>
		<table>
			<thead>
				<tr><th>Resolver</th><th>Success</th><th>Mean</th><th>Min / max</th></tr>
			</thead>
			<tbody id="results">
				<tr><td colspan="4" class="muted">No results yet.</td></tr>
			</tbody>
		</table>
	</section>
</main>

<script type="application/json" id="builtins">{{.Builtins}}</script>
</body>
</html>
